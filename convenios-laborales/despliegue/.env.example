# Configuración del despliegue autónomo (fase 3). Copie este fichero a `despliegue/.env`
# y revise los valores: `docker compose --env-file despliegue/.env -f despliegue/compose.yaml ...`
#
# Genere los secretos con: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

# --- Imagen del monitor ---------------------------------------------------------
# El monitor se publica solo con etiquetas semver y sha-<commit>; no existe «latest».
OPENPACTUM_VERSION=0.1.0
# Propietario de las imágenes en GHCR (cámbielo si usa un fork o una copia local).
OPENPACTUM_PROPIETARIO=danielrodriguez-star

# --- Rutas del host -------------------------------------------------------------
# Directorio de datos (lo crea datos-init con los permisos correctos).
OPENPACTUM_DATOS=/var/lib/openpactum/datos

# --- Secretos -------------------------------------------------------------------
# CAMBIAR por valores aleatorios distintos antes de arrancar.
POSTGRES_PASSWORD=CAMBIAR_CON_SECRETO_ALEATORIO
PAPERLESS_SECRET_KEY=CAMBIAR_CON_OTRO_SECRETO_ALEATORIO

# UID/GID de su usuario (id -u / id -g): lo usan Paperless, el monitor y datos-init.
USERMAP_UID=1000
USERMAP_GID=1000

# --- Modelos --------------------------------------------------------------------
# Con menos de 16 GB de RAM use, por ejemplo, qwen2.5:7b.
MODELO=llama3.1:8b

# --- Monitor del BOE ------------------------------------------------------------
# Intervalo del programador, en segundos (21600 = 6 h, como la tarea cron anterior).
OPENPACTUM_INTERVALO=21600
# Canal RSS del BOE; vacío = canal temático de convenios colectivos.
OPENPACTUM_RSS=
# Avisos por correo (opcional; sin SMTP_HOST solo se registra en el log del contenedor).
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
