# Configuración del despliegue autónomo (fase 3). Copie este fichero a `despliegue/.env`
# y revise los valores: `docker compose --env-file despliegue/.env -f despliegue/compose.yaml ...`

# --- Imagen del monitor ---------------------------------------------------------
# El monitor se publica solo con etiquetas semver y sha-<commit>; no existe «latest».
OPENPACTUM_VERSION=0.1.0
# Propietario de las imágenes en GHCR (cámbielo si usa un fork o una copia local).
OPENPACTUM_PROPIETARIO=danielrodriguez-star

# --- Rutas del host -------------------------------------------------------------
# Prefijo del proyecto y de los volúmenes. Cámbielo si quiere dos instalaciones (o una de
# pruebas) en el mismo equipo: los datos quedan en volúmenes con este prefijo.
OPENPACTUM_PREFIJO=openpactum
# Directorio de datos (lo crea secretos-init con los permisos correctos).
OPENPACTUM_DATOS=/var/lib/openpactum/datos

# --- Secretos -------------------------------------------------------------------
# No hay contraseñas en este fichero: `secretos-init` las genera en el volumen
# <prefijo>_secretos la primera vez que se ejecuta y no las sobrescribe después.
#
# PRIMER ARRANQUE (dos pasos, en este orden):
#   docker compose --env-file .env run --rm --no-deps secretos-init
#   docker compose --env-file .env up -d
# A partir de ahí basta con `up -d`. El contenedor de arranque (fase 4) hace los dos pasos
# con un solo comando.
#
# Para guardar un secreto que no se genera solo (por ejemplo, la contraseña SMTP):
#   printf '%s' 'clave' | docker compose --env-file .env run --rm -T --no-deps secretos-init escribir smtp_password

# UID/GID de su usuario (id -u / id -g): lo usan Paperless, el monitor y secretos-init.
USERMAP_UID=1000
USERMAP_GID=1000

# --- Modelos --------------------------------------------------------------------
# Modelo de conversación de Ollama y de AnythingLLM (los embeddings son fijos:
# nomic-embed-text). Con menos de 16 GB de RAM use, por ejemplo, qwen2.5:7b.
OPENPACTUM_MODELO=llama3.1:8b

# --- Monitor del BOE ------------------------------------------------------------
# Intervalo del programador, en segundos (21600 = 6 h, como la tarea cron anterior).
OPENPACTUM_INTERVALO=21600
# Canal RSS del BOE; vacío = canal temático de convenios colectivos.
OPENPACTUM_RSS=
# Directorio donde están el manifiesto y secretos-init.sh (vacío = el del manifiesto).
OPENPACTUM_DESPLEGUE=
# Avisos por correo (opcional; sin SMTP_HOST solo se registra en el log del contenedor).
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_TO=
SMTP_USER=
# Puede poner la contraseña aquí (queda en claro en este fichero) o guardarla en el volumen
# de secretos y descomentar la línea siguiente.
SMTP_PASSWORD=
#SMTP_PASSWORD_FILE=/run/secretos/smtp_password
SMTP_STARTTLS=true
